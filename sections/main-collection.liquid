{% stylesheet %}
  .collection-section {
    background: {{ settings.color_background }};
    color: {{ settings.color_text }};
    padding: 4rem;
  }

  .collection-header {
    max-width: 1400px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .collection-header h1 {
    font-family: {{ settings.font_heading }};
    font-size: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }

  .collection-header p {
    font-size: 1rem;
    color: {{ settings.color_taupe }};
    max-width: 700px;
    margin: 0 auto;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .product-card {
    position: relative;
    height: 450px;
    background: {{ settings.color_secondary }};
    border: 1px solid #2a2620;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    overflow: hidden;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .product-card::before {
    content: 'A';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: {{ settings.font_heading }};
    font-size: 5rem;
    color: rgba(201, 168, 108, 0.1);
    font-weight: 700;
    letter-spacing: 3px;
    z-index: 1;
    pointer-events: none;
  }

  .product-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 70%;
    object-fit: cover;
    z-index: 0;
  }

  .product-info {
    position: relative;
    z-index: 2;
    background: linear-gradient(to top, {{ settings.color_secondary }}, transparent);
    padding-top: 2rem;
  }

  .product-name {
    font-family: {{ settings.font_heading }};
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .product-price {
    font-family: {{ settings.font_heading }};
    font-size: 1rem;
    color: {{ settings.color_accent }};
  }

  .product-card:hover {
    border-color: {{ settings.color_accent }};
  }

  .product-card:hover .product-info {
    background: {{ settings.color_secondary }};
  }

  .collection-empty {
    text-align: center;
    padding: 4rem 2rem;
    color: {{ settings.color_taupe }};
  }

  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .collection-section {
      padding: 2rem;
    }

    .products-grid {
      grid-template-columns: 1fr;
    }

    .collection-header h1 {
      font-size: 1.8rem;
    }
  }
{% endstylesheet %}

<section class="collection-section">
  <div class="collection-header">
    <h1>{{ collection.title }}</h1>
    {% if collection.description %}
      <p>{{ collection.description | strip_html }}</p>
    {% endif %}
  </div>

  {% if collection.products.size > 0 %}
    <div class="products-grid">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="product-card">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}" class="product-image">
          {% endif %}
          <div class="product-info">
            <div class="product-name">{{ product.title }}</div>
            <div class="product-price">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="collection-empty">
      <p>No products in this collection yet.</p>
    </div>
  {% endif %}
</section>

{% schema %}
  {
    "name": "Collection Listing"
  }
{% endschema %}